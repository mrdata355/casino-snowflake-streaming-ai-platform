# -----------------------------------------------------------------------------
# SAFE TEMPLATE ONLY. Copy to .env locally. Never commit real secrets.
# -----------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
PLATFORM_PREFIX=CASINO
ENVIRONMENT=DEV

# Snowflake account and session
SNOWFLAKE_ACCOUNT_IDENTIFIER=MYORG-MYACCOUNT
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=KELLON_DEV
SNOWFLAKE_ROLE=CASINO_PLATFORM_ADMIN
SNOWFLAKE_WAREHOUSE=CASINO_DEV_ADMIN_WH
ADMIN_WAREHOUSE=CASINO_DEV_ADMIN_WH
INGEST_WAREHOUSE=CASINO_DEV_INGEST_WH
TRANSFORM_WAREHOUSE=CASINO_DEV_TRANSFORM_WH
FEATURE_WAREHOUSE=CASINO_DEV_FEATURE_WH
CORTEX_WAREHOUSE=CASINO_DEV_CORTEX_WH
ADMIN_WAREHOUSE_SIZE=XSMALL
INGEST_WAREHOUSE_SIZE=XSMALL
TRANSFORM_WAREHOUSE_SIZE=XSMALL
FEATURE_WAREHOUSE_SIZE=XSMALL
CORTEX_WAREHOUSE_SIZE=XSMALL
RESOURCE_MONITOR=CASINO_DEV_MONTHLY_RM
MONTHLY_CREDIT_QUOTA=25
DATA_RETENTION_DAYS=1
SNOWFLAKE_DATABASE=CASINO_DEV
SNOWFLAKE_SCHEMA=OPS

# Preferred authentication: encrypted PKCS#8 private key file
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=CHANGE_ME_LOCALLY
# Password auth is disabled unless explicitly enabled for temporary local use.
ALLOW_SNOWFLAKE_PASSWORD_AUTH=false
SNOWFLAKE_PASSWORD=DO_NOT_COMMIT_REAL_PASSWORD

# Optional Snowflake host and Spark connector settings
SNOWFLAKE_HOST=MYORG-MYACCOUNT.snowflakecomputing.com
SNOWFLAKE_SPARK_TEMP_SCHEMA=TEMP
SNOWFLAKE_SPARK_CONNECTOR_PACKAGE=net.snowflake:spark-snowflake_2.13:3.1.5

# OpsReady isolated execution gateway. Use a dedicated training account/workspace only.
OPSREADY_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,https://casino-snowflake-streaming-ai-platf-five.vercel.app
OPSREADY_ALLOW_ADMIN_LABS=false
OPSREADY_SESSION_TTL_MINUTES=60
SNOWFLAKE_TRAINING_DATABASE=OPSREADY_TRAINING

# Databricks training-only execution settings
DATABRICKS_HOST=https://your-training-workspace.cloud.databricks.com
DATABRICKS_TOKEN=DO_NOT_COMMIT_REAL_TOKEN
DATABRICKS_SQL_WAREHOUSE_ID=SET_LOCALLY
DATABRICKS_TRAINING_CATALOG=opsready_training
# Optional: enables bounded Python execution on a dedicated classic all-purpose training cluster.
DATABRICKS_CLUSTER_ID=

# Local disposable SQL Server sandbox used by docker compose --profile sandbox.
MSSQL_SA_PASSWORD=SET_STRONG_LOCAL_PASSWORD_ONLY

# Kafka and Spark Structured Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SLOT_TOPIC=casino.slot.events.v1
KAFKA_SLOT_DLQ_TOPIC=casino.slot.events.dlq.v1
STREAM_TRIGGER_INTERVAL=30 seconds
STREAM_WATERMARK_DELAY=10 minutes
STREAM_CHECKPOINT_PATH=/tmp/casino/checkpoints/slot-events-v1
SPARK_SHUFFLE_PARTITIONS=8

# Pub/Sub alternative
GCP_PROJECT_ID=your-gcp-project
PUBSUB_SLOT_TOPIC=casino-slot-events-v1

# MLflow and model settings
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=casino-player-value
MODEL_NAME=casino-player-value
MODEL_ALIAS=champion
DRIFT_PSI_THRESHOLD=0.20

# Feature API JWT settings. APP_ENV=test bypasses external JWT only in tests.
API_JWKS_URL=https://identity.example.com/.well-known/jwks.json
API_JWT_ISSUER=https://identity.example.com/
API_AUDIENCE=casino-feature-api

# Local demo output
DEMO_OUTPUT_DIR=build/demo
DEMO_RANDOM_SEED=355
