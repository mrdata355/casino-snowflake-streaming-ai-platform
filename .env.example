# Environment
APP_ENV=dev
PROJECT_NAME=casino-lakehouse-platform
LOG_LEVEL=INFO
TIMEZONE=America/New_York

# Snowflake
SNOWFLAKE_ORGANIZATION=ORG_NAME
SNOWFLAKE_ACCOUNT=ACCOUNT_NAME
SNOWFLAKE_ACCOUNT_IDENTIFIER=ORG_NAME-ACCOUNT_NAME
SNOWFLAKE_USER=CASINO_PIPELINE_SVC
SNOWFLAKE_ROLE=CASINO_PIPELINE_ROLE
SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_DATABASE=CASINO_DEV
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_WAREHOUSE=CASINO_INGEST_WH
SNOWFLAKE_HOST=ORG_NAME-ACCOUNT_NAME.snowflakecomputing.com
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_SEMANTIC_VIEW=CASINO_PROD.SEMANTIC.CASINO_OPERATIONS
SNOWFLAKE_CORTEX_TOKEN=

# Object storage and Snowpipe
CLOUD_PROVIDER=GCP
GCS_BUCKET=casino-data-dev
GCS_PREFIX=landing
SNOWFLAKE_STAGE=CASINO_DEV.BRONZE.CASINO_EXT_STAGE
SNOWFLAKE_PIPE=CASINO_DEV.BRONZE.SLOT_EVENT_PIPE

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SLOT_TOPIC=casino.slot.events.v1
KAFKA_TABLE_TOPIC=casino.table.events.v1
KAFKA_GROUP_ID=casino-spark-slot-v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# GCP Pub/Sub
GCP_PROJECT_ID=casino-data-dev
PUBSUB_SLOT_TOPIC=casino-slot-events-v1
PUBSUB_SLOT_SUBSCRIPTION=casino-slot-events-spark-v1
PUBSUB_DEAD_LETTER_TOPIC=casino-slot-events-dlq-v1
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

# Spark
SPARK_CHECKPOINT_ROOT=s3a://casino-checkpoints/dev
SPARK_TRIGGER_INTERVAL=30 seconds
SPARK_WATERMARK_DELAY=10 minutes
SPARK_SHUFFLE_PARTITIONS=200
SNOWFLAKE_SPARK_TEMP_SCHEMA=CASINO_DEV.TEMP

# Airflow and dbt
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
DBT_PROFILES_DIR=/opt/dbt
DBT_TARGET=dev
DBT_STATE_PATH=/opt/dbt/state

# APIs
FEATURE_API_HOST=0.0.0.0
FEATURE_API_PORT=8080
SCORING_API_PORT=8081
API_AUDIENCE=casino-data-products
API_JWT_ISSUER=https://issuer.example.com/
API_JWKS_URL=https://issuer.example.com/.well-known/jwks.json

# ML and MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=casino-player-value
MODEL_NAME=player_value_model
MODEL_STAGE=Production
FEATURE_LOOKBACK_DAYS=30
SCORE_FRESHNESS_MINUTES=15
DRIFT_PSI_THRESHOLD=0.20

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERT_WEBHOOK_URL=
